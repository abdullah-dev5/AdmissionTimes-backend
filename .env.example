# ---------------------------------------------------------------------------
# AdmissionTimes backend configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development            # set to "production" on every deployed host
API_VERSION=v1
# Comma-separated browser origins. "*" is only allowed outside production.
CORS_ORIGIN=http://localhost:5173
# Set when running behind a reverse proxy (true, or a hop count / subnet).
TRUST_PROXY=
LOG_LEVEL=                      # error | warn | info | debug (default: debug in dev, info otherwise)
SWAGGER_ENABLED=false           # /api-docs is always on in development
# Public URL of the web app (used in email links).
WEB_APP_URL=http://localhost:5173

# Database (Supabase Postgres)
DB_HOST=db.<project-ref>.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_POOL_MAX=20
# Optional: PEM CA bundle to verify the database TLS certificate.
DB_SSL_CA=
DB_SSL_REJECT_UNAUTHORIZED=false

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server only; required for signup verification and rep creation
SUPABASE_JWT_SECRET=            # only needed for legacy HS256 tokens

# JWT verification. Leave JWT_ISSUER / JWT_JWKS_URL empty to derive them from
# SUPABASE_URL (<SUPABASE_URL>/auth/v1 and <SUPABASE_URL>/auth/v1/.well-known/jwks.json).
JWT_ISSUER=
JWT_JWKS_URL=
JWT_AUDIENCE=authenticated
JWT_EXPIRY_TOLERANCE=30         # seconds of clock skew tolerated

# Development only: allow `x-user-id` header impersonation (never in production).
ALLOW_DEV_HEADER_AUTH=false

# Background jobs: run cron in exactly one process.
SCHEDULER_ENABLED=true

# Email (Nodemailer SMTP)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Push notifications (Expo)
PUSH_NOTIFICATIONS_ENABLED=true

# Realtime broadcast from the API (clients currently use postgres_changes)
REALTIME_ENABLED=false

# AI (Gemini)
AI_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_TIMEOUT_MS=12000
AI_MAX_INPUT_CHARS=16000
# UTC offset used to interpret calendar dates in AI deadline questions.
APP_UTC_OFFSET=+05:00

# Scraper integration (POST /api/v1/internal/scraper/ingest-batch)
SCRAPER_INTEGRATION_ENABLED=false
SCRAPER_PUBLISH_ENABLED=false
SCRAPER_INTERNAL_SERVICE_TOKEN=
# Create unknown universities automatically (otherwise records are skipped
# and reported in the admin scraper monitor).
SCRAPER_AUTO_CREATE_UNIVERSITIES=false
